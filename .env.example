# Copiar este archivo como .env y llenar los valores. .env NO se sube a GitHub (está en .gitignore).

# API key de Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcional: modelo de Gemini para scripts/extraer_json_pdf.py (por defecto gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# MongoDB para scripts/cargar_mongodb.py. Local: mongodb://localhost:27017
# Atlas: mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agro_panama
