{
  "descripcion": "Clima diario -> mensual por región: lluvia total, días con lluvia (>= 1 mm) y temperaturas promedio.",
  "origen": "clima_diario",
  "pipeline": [
    {"$group": {
      "_id": {"region": "$region", "fecha": {"$dateTrunc": {"date": "$fecha", "unit": "month"}}},
      "lluvia_mm": {"$sum": "$precipitation_sum"},
      "horas_lluvia": {"$sum": "$precipitation_hours"},
      "dias_lluvia": {"$sum": {"$cond": [{"$gte": ["$precipitation_sum", 1]}, 1, 0]}},
      "temp_max_c": {"$avg": "$temperature_2m_max"},
      "temp_min_c": {"$avg": "$temperature_2m_min"},
      "temp_media_c": {"$avg": "$temperature_2m_mean"}
    }},
    {"$project": {
      "_id": 0,
      "region": "$_id.region",
      "fecha": "$_id.fecha",
      "anio": {"$year": "$_id.fecha"},
      "mes": {"$month": "$_id.fecha"},
      "lluvia_mm": {"$round": ["$lluvia_mm", 1]},
      "horas_lluvia": 1,
      "dias_lluvia": 1,
      "temp_max_c": {"$round": ["$temp_max_c", 2]},
      "temp_min_c": {"$round": ["$temp_min_c", 2]},
      "temp_media_c": {"$round": ["$temp_media_c", 2]}
    }},
    {"$sort": {"region": 1, "fecha": 1}},
    {"$out": "clima_mensual"}
  ]
}
